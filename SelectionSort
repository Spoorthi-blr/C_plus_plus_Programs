class Solution {
  public:
    void selectionSort(vector<int> &arr) {
        // code here
        int minIndex = 0;
        for(int i = 0; i < arr.size()-1; i++)
        {
            int j = 0;
            minIndex = i;
            for(j = i+1; j< arr.size(); j++)
            {
                if(arr[j] < arr[minIndex]) minIndex = j;
            }
            
            int temp = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = temp;
        }
    }
};
