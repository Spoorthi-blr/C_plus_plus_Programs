class Solution {
  public:
    void reverseArray(vector<int> &arr) {
        // code here
        int count = arr.size()-1;
        for(int i = 0; i < arr.size()/2; i++)
        {
            int temp = arr[i];
            arr[i] = arr[count];
            arr[count] = temp;
            count--;
        }
    }
};
