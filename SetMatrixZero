Given a 2D matrix mat[][]. Modify the matrix such that if mat[i][j] is 0, all the elements in the i-th row and j-th column are set to 0.

Input: mat[][] = [[1, -1, 1], [-1, 0, 1], [1, -1, 1]]    
Output: [[1, 0, 1], [0, 0, 0], [1, 0, 1]]   
Explanation: mat[1][1] = 0, so all elements in row 1 and column 1 are updated to zeroes.

class Solution {
  public:
    void setMatrixZeroes(vector<vector<int>> &mat) {
        // code here
        
        int n = mat.size();
        int m = mat[0].size();
        int row = 0, col = 0;
        for(int i = 0; i < n; i++)
        {
            for (int j = 0; j < m; j++)
            {
                if(mat[i][j] == 0)
                {
                     row = i; 
                     col = j; 
                }
            }
        }
        
        for(int i = row; i < row+1; i++)
        {
            for(int j = 0; j < m; j++)
            {
                mat[i][j] = 0; 
            }
        }
        
        for(int i = 0; i < n; i++)
        {
            for(int j = col; j < col +1; j++)
            {
                mat[i][j] = 0;
            }
        }
    }
};

Better Solution
class Solution {
  public:
    void setMatrixZeroes(vector<vector<int>> &mat) {
        // code here
        
        int n = mat.size();
        int m = mat[0].size();

        int row[n] = {false};
        int col[m] = {false};
        for(int i = 0; i < n; i++)
        {
            for (int j = 0; j < m; j++)
            {
                if(mat[i][j] == 0)
                {
                    row[i] = true;      
                    col[j] = true; 
                }
            }
        }
        
        for(int i = 0; i < n; i++)
        {
            for(int j = 0; j < m; j++)
            {
                if(row[i] || col[j])
                {
                    mat[i][j] = 0; 
                }
            }
        }
        
    }
};
