O(n2) Solution
int maxSubarraySum(int arr[], int n) {
    // Code here
    int sum = 0;
    int maxSum = 0;
    for(int i = 0; i < n; i++)
    {
        sum += arr[i];
        for(int j = i+1; j <n; j++ )
        {
            sum += arr[j];
        }
        
        if(sum > maxSum)
            maxSum = sum;
        
        sum = 0;
    }
    return maxSum;
}

Kadane Algorithm

int maxSubarraySum(int arr[], int n)
{
    int sum = arr[0];
    int maxSum = arr[0];

    for(int i = 1; i < n; i++)
    {
        if(sum + arr[i] > arr[i])
            sum = sum + arr[i];
        else
            sum = arr[i];

        if(sum > maxSum)
            maxSum = sum;
    }

    return maxSum;
}
